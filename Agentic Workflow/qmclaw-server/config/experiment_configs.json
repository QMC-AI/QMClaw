{
  "experiments": {
    "spectroscopy": {
      "name": "Spectroscopy",
      "description": "VNA spectroscopy — broad frequency scan to find qubit resonance",
      "function": "sq.spectroscopy",
      "defaultCommand": "sq.spectroscopy({qubit}, freq=np.arange(-0.1, 0.1, 0.002) + {qubit}.regs.f10)",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "f10"
      ]
    },
    "s21": {
      "name": "Cavity S21",
      "description": "Cavity S21 — narrowband frequency scan around cavity resonance",
      "function": "sq.s21",
      "defaultCommand": "sq.s21({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "fread"
      ]
    },
    "iqraw": {
      "name": "IQ Raw",
      "description": "Acquire raw I/Q data for qubit state discrimination",
      "function": "sq.iqraw",
      "defaultCommand": "sq.iqraw({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "qter.fitData({exp_num}, collect=True, do_plot=False)",
      "metricsToExtract": [
        "SNR",
        "F0",
        "F1",
        "separation"
      ]
    },
    "t1": {
      "name": "T1 Relaxation",
      "description": "Measure qubit relaxation time via variable delay pulse sequence",
      "function": "sq.t1",
      "defaultCommand": "sq.t1({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "T1"
      ]
    },
    "ramsey": {
      "name": "Ramsey",
      "description": "Ramsey with detuning — measure T2* dephasing time",
      "function": "sq.ramsey_df",
      "defaultCommand": "sq.ramsey_df({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "T2",
        "detuning"
      ]
    },
    "piamp": {
      "name": "Pi Pulse Amplitude",
      "description": "Calibrate π-pulse amplitude for X gate via Rabi oscillation",
      "function": "sq.piamp",
      "defaultCommand": "sq.piamp({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "pi_amplitude"
      ]
    },
    "xeb": {
      "name": "Cross-Entropy Benchmarking",
      "description": "Measure single-qubit gate fidelity",
      "function": "sq.xeb",
      "defaultCommand": "sq.xeb({qubit})",
      "defaultPlotCommand": "from lqms.data_process.xeb import process_xeb as px\npx.XEB(data,[{exp_num}],collect=True, do_plot=True)",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "gate_fidelity",
        "error_per_cycle"
      ]
    },
    "s21_dis": {
      "name": "S21 Dispersive Shift",
      "description": "Measure cavity transmission shift vs qubit state",
      "function": "sq.s21_dis",
      "defaultCommand": "sq.s21_dis({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "dispersive_shift"
      ]
    },
    "allxy": {
      "name": "AllXY",
      "description": "Characterize all 21 gate error combinations",
      "function": "sq.allxy",
      "defaultCommand": "sq.allxy({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "available": false,
      "note": "sq_nodes 没有 sq.allxy（21 种门错误组合实验未移植）。最接近的是 sq.time_rabi（单条 Rabi 扫描），只能部分替代。",
      "alternative": {
        "function": "sq.time_rabi",
        "defaultCommand": "sq.time_rabi({qubit})"
      },
      "metricsToExtract": [
        "average_fidelity",
        "leakage"
      ]
    },
    "single_shot": {
      "name": "Single-shot Fidelity",
      "description": "Measure qubit readout fidelity in single-shot regime",
      "function": "sq.single_shot",
      "defaultCommand": "sq.single_shot({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "available": false,
      "note": "sq_nodes 没有单发读出函数。可用 sq.iqraw（多次平均的 IQ 读出）近似态区分度，再用 sq.xeb 评估门保真度。",
      "alternative": {
        "function": "sq.iqraw",
        "defaultCommand": "sq.iqraw({qubit})"
      },
      "metricsToExtract": [
        "readout_fidelity"
      ]
    },
    "pulsed_spec": {
      "name": "Pulsed Spectroscopy",
      "description": "Qubit spectroscopy with pump pulse for higher SNR",
      "function": "sq.spectroscopy_iq",
      "defaultCommand": "sq.spectroscopy_iq({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "available": true,
      "note": "原 sq.pulsed_spec 在 sq_nodes 中不存在，已映射到脉冲谱学 sq.spectroscopy_iq。",
      "metricsToExtract": [
        "qubit_frequency"
      ]
    },
    "swap": {
      "name": "SWAP",
      "description": "Characterize SWAP gate for two-qubit operations",
      "function": "sq.swap",
      "defaultCommand": "sq.swap({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "available": false,
      "note": "sq_nodes 只提供单比特函数，没有双比特 SWAP 实验；当前无法直接测。",
      "metricsToExtract": [
        "swap_fidelity"
      ]
    },
    "drag_calibrate": {
      "name": "DRAG Calibration",
      "description": "Optimize DRAG coefficient for leakage suppression",
      "function": "sq.drag_calibrate",
      "defaultCommand": "sq.drag_calibrate({qubit})",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "available": false,
      "note": "sq_nodes 没有 DRAG 自动标定函数。可用 sq.pulse_shape / sq.set_pi 手工调 alpha（DRAG 系数）后用 sq.xeb 观察泄漏是否下降。",
      "alternative": {
        "function": "sq.pulse_shape",
        "defaultCommand": "sq.pulse_shape({qubit})"
      },
      "metricsToExtract": [
        "optimal_drag"
      ]
    }
  }
}
