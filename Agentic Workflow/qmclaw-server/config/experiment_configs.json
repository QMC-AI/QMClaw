{
  "experiments": {
    "spectroscopy": {
      "name": "Spectroscopy",
      "description": "VNA spectroscopy — broad frequency scan to find qubit resonance",
      "function": "sq.spectroscopy",
      "defaultCommand": "sq.spectroscopy({qubit}, do_plot=True)",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "f10"
      ]
    },
    "s21": {
      "name": "Cavity S21",
      "description": "Cavity S21 — narrowband frequency scan around cavity resonance",
      "function": "sq.s21",
      "defaultCommand": "sq.s21({qubit}, do_plot=True)",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "fread"
      ]
    },
    "iqraw": {
      "name": "IQ Raw",
      "description": "Acquire raw I/Q data for qubit state discrimination",
      "function": "sq.iqraw",
      "defaultCommand": "sq.iqraw({qubit}, do_plot=True)",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "qter.fitData({exp_num}, collect=True, do_plot=False)",
      "metricsToExtract": [
        "SNR",
        "F0",
        "F1",
        "separation"
      ]
    },
    "t1": {
      "name": "T1 Relaxation",
      "description": "Measure qubit relaxation time via variable delay pulse sequence",
      "function": "sq.t1",
      "defaultCommand": "sq.t1({qubit}, do_plot=True)",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "T1"
      ]
    },
    "ramsey": {
      "name": "Ramsey",
      "description": "Ramsey with detuning — measure T2* dephasing time",
      "function": "sq.ramsey",
      "defaultCommand": "sq.ramsey_df({qubit}, do_plot=True)",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "T2",
        "detuning"
      ]
    },
    "piamp": {
      "name": "Pi Pulse Amplitude",
      "description": "Calibrate π-pulse amplitude for X gate via Rabi oscillation",
      "function": "sq.piamp",
      "defaultCommand": "sq.piamp({qubit}, do_plot=True)",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "pi_amplitude"
      ]
    },
    "xeb": {
      "name": "Cross-Entropy Benchmarking",
      "description": "Measure single-qubit gate fidelity",
      "function": "sq.xeb",
      "defaultCommand": "sq.xeb({qubit}, do_plot=True)",
      "defaultPlotCommand": "from lqms.data_process.xeb import process_xeb as px\npx.XEB(data,[{exp_num}],collect=True, do_plot=True)",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "gate_fidelity",
        "error_per_cycle"
      ]
    },
    "s21_dis": {
      "name": "S21 Dispersive Shift",
      "description": "Measure cavity transmission shift vs qubit state",
      "function": "sq.s21_dis",
      "defaultCommand": "sq.s21_dis({qubit}, do_plot=True)",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "dispersive_shift"
      ]
    },
    "allxy": {
      "name": "AllXY",
      "description": "Characterize all 21 gate error combinations",
      "function": "sq.allxy",
      "defaultCommand": "sq.allxy({qubit}, do_plot=True)",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "average_fidelity",
        "leakage"
      ]
    },
    "single_shot": {
      "name": "Single-shot Fidelity",
      "description": "Measure qubit readout fidelity in single-shot regime",
      "function": "sq.single_shot",
      "defaultCommand": "sq.single_shot({qubit}, do_plot=True)",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "readout_fidelity"
      ]
    },
    "pulsed_spec": {
      "name": "Pulsed Spectroscopy",
      "description": "Qubit spectroscopy with pump pulse for higher SNR",
      "function": "sq.pulsed_spec",
      "defaultCommand": "sq.pulsed_spec({qubit}, do_plot=True)",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
        "qubit_frequency"
      ]
    },
    "swap": {
      "name": "SWAP",
      "description": "Characterize SWAP gate for two-qubit operations",
      "function": "sq.swap",
      "defaultCommand": "sq.swap({qubit}, do_plot=True)",
      "defaultPlotCommand": "qter.fitData({exp_num})",
      "defaultAnalysisCommand": "",
      "metricsToExtract": [
